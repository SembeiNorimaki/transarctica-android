{
    "tutorial_1": {
        "title": "The daily run",
        "description": "Take coal from the Coal Mine to the Foundry, like every day.",
        "is_main_quest": true,
        "intro": {
            "character": "coal_boss",
            "text": "Morning, kid. Same as always: load coal here and run it to the Foundry. Don't let the train run dry on the way.",
            "choices": [
                {
                    "id": "accept",
                    "text": "Accept",
                    "accept": true
                },
                {
                    "id": "decline",
                    "text": "Not now"
                }
            ]
        },
        "outro": {
            "character": "smelter",
            "text": "Right on time, as usual. Listen, we are almost out of iron. If we had ore, the furnaces would be roaring again.",
            "choices": [
                {
                    "id": "ok",
                    "text": "Thanks"
                }
            ]
        },
        "objectives": [
            {
                "id": "reach_coal_mine",
                "type": "reach_city",
                "description": "Go to the Coal Mine",
                "target_city": "Coal Mine"
            },
            {
                "id": "deliver_coal",
                "type": "deliver_goods",
                "description": "Sell 40 coal at the Foundry",
                "target_city": "Foundry",
                "target_resource": "coal",
                "target_qty": 40
            }
        ],
        "rewards": {
            "money": 60
        }
    },
